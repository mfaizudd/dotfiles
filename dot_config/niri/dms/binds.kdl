binds {
    Alt+space hotkey-overlay-title="Default Launcher: Toggle" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Power Menu: Toggle" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+V hotkey-overlay-title="Clipboard: Toggle" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Super+Alt+L hotkey-overlay-title="Lock Screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+Ctrl+V hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+Shift+S { screenshot; }
    Mod+Alt+P allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    Mod+E hotkey-overlay-title="Open File Manager (nautilus)" { spawn "nautilus"; }
}
