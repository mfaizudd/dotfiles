// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1786879356614598247 @name=Alacritty
window-rule {
    match app-id="^Alacritty$"
    background-effect {
        blur true
    }
}

// @id=wr_1786890644250874281 @name=spotify
window-rule {
    match app-id="^spotify$"
    default-column-width { fixed 1550; }
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}

// @id=wr_1790175292833017314 @name=it.mijorus.smile
window-rule {
    match app-id="^it.mijorus.smile$"
    open-floating true
}
