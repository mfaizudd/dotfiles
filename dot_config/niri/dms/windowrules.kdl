// DMS Window Rules - Managed by Dux Modular Shell
// Do not edit manually - changes may be overwritten

// @id=wr_1786879356614598247 @name=Alacritty
window-rule {
    match app-id="^Alacritty$"
    background-effect {
        blur true
    }
}

// @id=wr_1786890644250874281 @name=spotify
window-rule {
    match app-id="^spotify$"
    default-column-width { fixed 1550; }
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=wr_1790175292833017314 @name=it.mijorus.smile
window-rule {
    match app-id="^it.mijorus.smile$"
    open-floating true
}

// @id=wr_1794964527843096130 @name=dev.zellij.Zellij
window-rule {
    match app-id="^dev.zellij.Zellij$"
    background-effect {
        blur true
    }
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
